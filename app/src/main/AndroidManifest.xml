<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Without this, Android 11+ package visibility hides every other app:
         getLaunchIntentForPackage returns null and scoped rows show package
         names instead of labels/icons. SpoofMyDevice declares it too. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Authority must match <applicationId>.XposedService
             (io.github.libxposed.service.IXposedService.AUTHORITY_SUFFIX). -->
        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="com.muse.lazyspoof.XposedService"
            android:exported="true" />

        <!-- Lets a hooked target process record itself as in-scope (package
             name only) so the UI's Quick Reset list works without root. -->
        <provider
            android:name=".utils.ScopeSeenProvider"
            android:authorities="com.muse.lazyspoof.scope_seen"
            android:exported="true" />

        <meta-data
            android:name="xposedmodule"
            android:value="true" />

        <meta-data
            android:name="xposeddescription"
            android:value="@string/xposed_description" />

        <meta-data
            android:name="xposedminversion"
            android:value="82" />

        <!-- No xposedscope: the module recommends no apps. The Advertising ID
             and App Set ID are rewritten inside each scoped app, so Play
             services does not have to be in the scope. -->

    </application>

</manifest>
